# Explicit build-context allowlist: no secrets, databases, evidence or weights.
**
!docker/
!docker/**
!backend/
!backend/**
!speech/
!speech/**
!nlp/
!nlp/**
!frontend/
!frontend/**
!tests/
!tests/**
!tools/
!tools/**
!config/
!config/data/
!config/data/current_dataset.json
!config/runtime_assets.json
!data/
!data/current/
!data/current/*.csv
!alembic.ini
!pipeline_model.json
!asr_config.json
!pytest.ini

# Exclude generated/private files even below allowed source directories.
**/__pycache__/**
**/*.pyc
**/.env
**/.env.*
**/node_modules/**
**/dist/**
**/.vite/**
**/.pytest_cache/**
**/*.sqlite*
**/*.db
**/*.dump
**/*.pt
**/*.pth
**/*.safetensors
**/*.pem
**/*.key
