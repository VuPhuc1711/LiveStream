# Compose reads POSTGRES_* from this file. Do not commit real credentials.
# Backend Docker builds its own URL to postgres:5432, with proper password escaping.
POSTGRES_DB=livestream
POSTGRES_USER=livestream_app
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
POSTGRES_PORT=5433
# DATABASE_URL below is for running the backend directly on Windows only.
# Match credentials above; URL-encode special characters in this native URL.
DATABASE_URL=postgresql+psycopg://livestream_app:REPLACE_WITH_A_RANDOM_PASSWORD@127.0.0.1:5433/livestream
# For rollback: DATABASE_URL=sqlite:///D:/livestream-violation-detection/runtime/livestream.sqlite3
